{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/frameworks/<id>.json",
  "type": "object",
  "required": ["id", "name", "configs", "disableHint", "verifiedAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "configs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "format", "pointer", "scope"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "format": { "enum": ["json", "jsonc", "toml", "yaml"] },
          "pointer": { "type": "string", "pattern": "^(/[^/]+)+$" },
          "scope": { "enum": ["user", "project"] },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["linux", "darwin", "win32"] }
          }
        }
      }
    },
    "disableHint": { "type": "string", "minLength": 1 },
    "verifiedAt": {
      "anyOf": [{ "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" }, { "type": "null" }]
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
