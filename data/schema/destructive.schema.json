{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/destructive.json",
  "type": "object",
  "required": ["version", "words"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "words": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+$" }, "minItems": 1, "uniqueItems": true }
  }
}
