{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/common-flags.json",
  "type": "object",
  "required": ["version", "flags"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "flags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "uniqueItems": true }
  }
}
