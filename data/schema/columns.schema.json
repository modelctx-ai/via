{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data/columns.json",
  "type": "object",
  "required": ["version", "maxColumns", "priority", "labelKeys"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "maxColumns": { "type": "integer", "minimum": 1 },
    "priority": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "labelKeys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
