{
  "id": "vscode",
  "name": "VS Code",
  "configs": [
    { "path": ".vscode/mcp.json", "format": "jsonc", "pointer": "/servers", "scope": "project" },
    { "path": "~/.config/Code/User/mcp.json", "format": "jsonc", "pointer": "/servers", "scope": "user", "platforms": ["linux"] },
    { "path": "~/Library/Application Support/Code/User/mcp.json", "format": "jsonc", "pointer": "/servers", "scope": "user", "platforms": ["darwin"] },
    { "path": "%APPDATA%/Code/User/mcp.json", "format": "jsonc", "pointer": "/servers", "scope": "user", "platforms": ["win32"] }
  ],
  "disableHint": "运行命令 MCP: List Servers，选中 server 后选择 Disable；全局关闭 MCP 可把设置 chat.mcp.access 设为 none",
  "verifiedAt": "2026-10-20",
  "sources": [
    "https://code.visualstudio.com/docs/agents/reference/mcp-configuration",
    "https://code.visualstudio.com/docs/agents/run/manage-mcp-servers",
    "https://github.com/microsoft/vscode/blob/main/src/vs/platform/userDataProfile/common/userDataProfile.ts",
    "https://github.com/microsoft/vscode/blob/main/src/vs/platform/mcp/common/mcpManagement.ts"
  ],
  "notes": "只读取 mcp.json；旧版 settings.json 中的 mcp.servers 不读取。用户配置位于默认配置档（profile）的 User 目录，其他配置档与 Insiders 的路径不同，暂不探测。工作区根目录的 .mcp.json（实验性设置 chat.mcp.workspaceRootConfig.enabled）与 ~/.copilot/mcp-config.json 分别由 claude-code 与 copilot-cli 条目覆盖。含 ${input:...} 的值 via 无法展开，会告警。"
}
