{
  "version": 1,
  "domains": {
    "code":    { "servers": ["github", "gitlab", "sentry"] },
    "search":  { "servers": ["exa", "tavily", "brave-search", "context7"] },
    "browser": { "servers": ["playwright", "puppeteer", "chrome-devtools"] },
    "data":    { "servers": ["postgres", "sqlite", "bigquery"] },
    "docs":    { "servers": ["notion", "confluence", "google-drive"] },
    "project": { "servers": ["linear", "jira", "asana"] },
    "comm":    { "servers": ["slack", "gmail"] },
    "fs":      { "servers": ["filesystem"] },
    "cloud":   { "servers": ["cloudflare"] }
  },
  "match": ["alias", "package", "host"],
  "heuristic": {
    "threshold": 0.5,
    "leadRatio": 1.5,
    "signalWeights": { "param": 4, "resource": 3, "identity": 2, "description": 1 },
    "minScore": 10,
    "stopwords": [
      "a", "about", "across", "all", "also", "among", "an", "and", "another", "any", "are", "at",
      "available", "based", "be", "been", "being", "between", "but", "by", "can", "could", "current",
      "data", "default", "detail", "details", "did", "do", "does", "during", "each", "else", "etc",
      "every", "existing", "first", "for", "from", "given", "had", "has", "have", "here", "how", "if",
      "in", "include", "includes", "including", "info", "information", "into", "is", "it", "item",
      "items", "its", "just", "last", "least", "less", "may", "might", "more", "most", "must", "new",
      "next", "no", "nor", "not", "of", "on", "one", "only", "onto", "optional", "or", "other", "our",
      "over", "own", "per", "previous", "required", "result", "results", "return", "returned",
      "returns", "same", "server", "shall", "should", "so", "some", "specific", "such", "than",
      "that", "the", "their", "then", "there", "these", "this", "those", "three", "through", "to",
      "tool", "tools", "two", "under", "use", "used", "uses", "using", "value", "values", "very",
      "via", "was", "we", "were", "what", "when", "where", "which", "while", "who", "whom", "whose",
      "why", "will", "with", "without", "would", "you", "your", "yours"
    ],
    "flatBelowProviders": 6
  }
}
