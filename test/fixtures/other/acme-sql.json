{
  "tools": [
    {
      "name": "run_query",
      "description": "Run a SQL query against the database.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "sql"
        ]
      }
    },
    {
      "name": "explain_query",
      "description": "Show the query plan for a SQL statement.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string"
          }
        },
        "required": [
          "sql"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_tables",
      "description": "List tables in a database.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string"
          }
        },
        "required": [
          "database"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "describe_table",
      "description": "Describe the columns and indexes of a table.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string"
          },
          "table": {
            "type": "string"
          }
        },
        "required": [
          "database",
          "table"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_databases",
      "description": "List databases on the server.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}
