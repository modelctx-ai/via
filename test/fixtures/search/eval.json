{
  "description": "Natural-language find queries and the canonical tools an agent would accept as the answer, over test/fixtures/tools. `expect` lists acceptable refs; a query is scored by the best rank among them. Groups: direct (already works lexically, guards against regressions), synonym (verb or resource worded differently from the tool name), phrase (longer or inflected wording).",
  "queries": [
    { "q": "github issue:read", "group": "direct", "expect": ["github issue:read"] },
    { "q": "create a pull request", "group": "direct", "expect": ["github pull-request:create"] },
    { "q": "merge pull request", "group": "direct", "expect": ["github pull-request:merge"] },
    { "q": "take a screenshot", "group": "direct", "expect": ["playwright browser-take-screenshot", "puppeteer screenshot"] },
    { "q": "send an email message", "group": "direct", "expect": ["gmail message:send"] },
    { "q": "list tables", "group": "direct", "expect": ["sqlite table:list"] },
    { "q": "post message to channel", "group": "direct", "expect": ["slack post-message"] },
    { "q": "search the web", "group": "direct", "expect": ["exa web:search", "tavily search"] },
    { "q": "create a calendar event", "group": "direct", "expect": ["notion calendar-event:create"] },
    { "q": "list branches", "group": "direct", "expect": ["github branch:list"] },
    { "q": "press a key", "group": "direct", "expect": ["playwright browser-press-key"] },
    { "q": "add a comment to an issue", "group": "direct", "expect": ["github issue-comment:add", "linear comment:create"] },

    { "q": "remove a file from the repository", "group": "synonym", "expect": ["github file:delete"] },
    { "q": "merge a PR", "group": "synonym", "expect": ["github pull-request:merge"] },
    { "q": "open a new PR", "group": "synonym", "expect": ["github pull-request:create"] },
    { "q": "show the changes in a merge request", "group": "synonym", "expect": ["github pull-request:read"] },
    { "q": "retrieve commit details", "group": "synonym", "expect": ["github commit:get"] },
    { "q": "look up code in a repo", "group": "synonym", "expect": ["github code:search"] },
    { "q": "fork a repository", "group": "synonym", "expect": ["github repository:fork"] },
    { "q": "start a workflow run", "group": "synonym", "expect": ["github action-run:trigger"] },
    { "q": "fetch the logs of a CI job", "group": "synonym", "expect": ["github job-log:get"] },
    { "q": "show all tags", "group": "synonym", "expect": ["github tag:list"] },
    { "q": "submit a code review", "group": "synonym", "expect": ["github pull-request-review:write"] },
    { "q": "respond to a review comment", "group": "synonym", "expect": ["github reply-to-pull-request-comment:add"] },
    { "q": "edit a ticket", "group": "synonym", "expect": ["github issue:write", "linear issue:update"] },
    { "q": "modify an issue", "group": "synonym", "expect": ["linear issue:update", "github issue:write"] },
    { "q": "who am I", "group": "synonym", "expect": ["github me:get", "notion self:get"] },
    { "q": "commit several files to a branch", "group": "synonym", "expect": ["github file:push"] },
    { "q": "post a comment on a ticket", "group": "synonym", "expect": ["github issue-comment:add", "linear comment:create"] },
    { "q": "list contributors of a repo", "group": "synonym", "expect": ["github repository-collaborator:list"] },
    { "q": "find users", "group": "synonym", "expect": ["github user:search"] },
    { "q": "create a ticket", "group": "synonym", "expect": ["linear issue:create", "github issue:write"] },
    { "q": "what tickets are assigned to me", "group": "synonym", "expect": ["linear my-issue:list"] },
    { "q": "list sprints", "group": "synonym", "expect": ["linear cycle:list"] },
    { "q": "workflow states of a ticket", "group": "synonym", "expect": ["linear issue-status:list"] },
    { "q": "tags for tickets", "group": "synonym", "expect": ["linear issue-label:list"] },
    { "q": "search the docs", "group": "synonym", "expect": ["linear documentation:search"] },
    { "q": "remove a page", "group": "synonym", "expect": ["notion page:delete"] },
    { "q": "copy a page", "group": "synonym", "expect": ["notion page:duplicate"] },
    { "q": "undelete a page", "group": "synonym", "expect": ["notion page:restore"] },
    { "q": "relocate a page", "group": "synonym", "expect": ["notion page:move"] },
    { "q": "edit a page", "group": "synonym", "expect": ["notion page:update"] },
    { "q": "make a new page", "group": "synonym", "expect": ["notion page:create"] },
    { "q": "query a database", "group": "synonym", "expect": ["notion data-source:query"] },
    { "q": "schedule a meeting", "group": "synonym", "expect": ["notion calendar-event:create"] },
    { "q": "retrieve the content of a page", "group": "synonym", "expect": ["notion fetch"] },
    { "q": "react with an emoji", "group": "synonym", "expect": ["slack reaction:add", "notion comment-reaction:set"] },
    { "q": "send a message to a channel", "group": "synonym", "expect": ["slack post-message"] },
    { "q": "respond in a thread", "group": "synonym", "expect": ["slack reply-to-thread"] },
    { "q": "read channel messages", "group": "synonym", "expect": ["slack channel-history:get"] },
    { "q": "show conversation history", "group": "synonym", "expect": ["slack channel-history:get", "slack thread-reply:get"] },
    { "q": "who is this person", "group": "synonym", "expect": ["slack user-profile:get", "slack user:get"] },
    { "q": "write an email draft", "group": "synonym", "expect": ["gmail draft:create"] },
    { "q": "search my inbox", "group": "synonym", "expect": ["gmail message:search"] },
    { "q": "read a mail", "group": "synonym", "expect": ["gmail message:read"] },
    { "q": "delete an email", "group": "synonym", "expect": ["gmail message:delete"] },
    { "q": "add a tag to an email", "group": "synonym", "expect": ["gmail message:modify"] },
    { "q": "read an email conversation", "group": "synonym", "expect": ["gmail thread:read"] },
    { "q": "share a document with someone", "group": "synonym", "expect": ["google-drive share-file"] },
    { "q": "find a file in my drive", "group": "synonym", "expect": ["google-drive search", "google-drive file:list"] },
    { "q": "make a new folder", "group": "synonym", "expect": ["google-drive folder:create", "filesystem directory:create"] },
    { "q": "rename a file", "group": "synonym", "expect": ["filesystem file:move", "google-drive file:move"] },
    { "q": "save content to a file", "group": "synonym", "expect": ["filesystem file:write"] },
    { "q": "list folder contents", "group": "synonym", "expect": ["filesystem directory:list"] },
    { "q": "locate files by pattern", "group": "synonym", "expect": ["filesystem file:search"] },
    { "q": "modify part of a file", "group": "synonym", "expect": ["filesystem file:edit"] },
    { "q": "read many files at once", "group": "synonym", "expect": ["filesystem multiple-file:read"] },
    { "q": "file metadata", "group": "synonym", "expect": ["filesystem file-info:get"] },
    { "q": "open a url in the browser", "group": "synonym", "expect": ["playwright browser:navigate", "puppeteer navigate"] },
    { "q": "go back to the previous page", "group": "synonym", "expect": ["playwright browser-back:navigate"] },
    { "q": "enter text into a field", "group": "synonym", "expect": ["playwright browser-type", "puppeteer fill", "playwright browser-fill-form"] },
    { "q": "tap a button", "group": "synonym", "expect": ["playwright browser:click", "puppeteer click"] },
    { "q": "execute javascript on the page", "group": "synonym", "expect": ["playwright browser-evaluate", "puppeteer evaluate", "playwright browser-code:run"] },
    { "q": "choose a dropdown option", "group": "synonym", "expect": ["playwright browser-select-option", "puppeteer select"] },
    { "q": "list open tabs", "group": "synonym", "expect": ["playwright browser-tabs"] },
    { "q": "capture the page as an image", "group": "synonym", "expect": ["playwright browser-take-screenshot", "puppeteer screenshot"] },
    { "q": "watch http requests", "group": "synonym", "expect": ["playwright browser-network-requests"] },
    { "q": "insert a row", "group": "synonym", "expect": ["sqlite query:write"] },
    { "q": "show the table schema", "group": "synonym", "expect": ["sqlite table:describe"] },
    { "q": "make a new table", "group": "synonym", "expect": ["sqlite table:create"] },
    { "q": "run a sql statement", "group": "synonym", "expect": ["postgres query", "sqlite query:read"] },
    { "q": "look up library documentation", "group": "synonym", "expect": ["context7 library-doc:get"] },
    { "q": "find a library id", "group": "synonym", "expect": ["context7 library-id:resolve"] },
    { "q": "scrape the content of a url", "group": "synonym", "expect": ["tavily extract"] },
    { "q": "spider a website", "group": "synonym", "expect": ["tavily crawl", "exa crawling"] },
    { "q": "research a company", "group": "synonym", "expect": ["exa company-research"] },
    { "q": "code examples for a library", "group": "synonym", "expect": ["exa code-context:get", "context7 library-doc:get"] },
    { "q": "who am I on cloudflare", "group": "synonym", "expect": ["cloudflare whoami"] },

    { "q": "tell me about the pull request and its discussion", "group": "phrase", "expect": ["github pull-request:read"] },
    { "q": "I want to cancel an event on my calendar", "group": "phrase", "expect": ["notion calendar-event:cancel"] },
    { "q": "I need to deleting old comments", "group": "phrase", "expect": ["notion comment:delete"] },
    { "q": "creating issues", "group": "phrase", "expect": ["linear issue:create", "github issue:write"] },
    { "q": "searching repositories", "group": "phrase", "expect": ["github repository:search"] },
    { "q": "updated pull requests", "group": "phrase", "expect": ["github pull-request:update", "github pull-request-branch:update"] },
    { "q": "please show me my unread messages", "group": "phrase", "expect": ["gmail message:search", "gmail message:read"] },
    { "q": "get the workspace members", "group": "phrase", "expect": ["notion user:get", "linear user:list"] },
    { "q": "download an attachment", "group": "phrase", "expect": ["notion attachment:download", "notion file-download-url:get"] },
    { "q": "upload a file to a web page", "group": "phrase", "expect": ["playwright browser-file:upload"] }
  ]
}
