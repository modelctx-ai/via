{
  "description": "A second evaluation set written after data/synonyms.json was tuned against eval.json, and never used to tune it: it estimates how the synonym data generalises. Same format as eval.json.",
  "queries": [
    { "q": "get the details of a pull request", "group": "synonym", "expect": ["github pull-request:read"] },
    { "q": "see a ticket", "group": "synonym", "expect": ["linear issue:get", "github issue:read"] },
    { "q": "new repository", "group": "synonym", "expect": ["github repository:create"] },
    { "q": "close the browser", "group": "direct", "expect": ["playwright browser:close"] },
    { "q": "destroy a database", "group": "synonym", "expect": ["notion database:delete"] },
    { "q": "enumerate branches", "group": "synonym", "expect": ["github branch:list"] },
    { "q": "update a project", "group": "direct", "expect": ["linear project:update"] },
    { "q": "browse the people in my team", "group": "synonym", "expect": ["linear user:list", "linear team:get", "github team-member:get"] },
    { "q": "send a direct reply in a conversation", "group": "synonym", "expect": ["slack reply-to-thread"] },
    { "q": "execute a command on cloudflare", "group": "synonym", "expect": ["cloudflare execute"] },
    { "q": "hover over an element", "group": "direct", "expect": ["playwright browser-hover", "puppeteer hover"] },
    { "q": "pick an option from a select", "group": "synonym", "expect": ["playwright browser-select-option", "puppeteer select"] },
    { "q": "check the status of a workflow run", "group": "synonym", "expect": ["github action:get", "github check-run:get"] },
    { "q": "write to a file", "group": "direct", "expect": ["filesystem file:write"] },
    { "q": "duplicate a page", "group": "direct", "expect": ["notion page:duplicate"] },
    { "q": "recover a deleted page", "group": "synonym", "expect": ["notion page:restore"] },
    { "q": "invite someone to a document", "group": "synonym", "expect": ["google-drive share-file"] },
    { "q": "explain a table", "group": "synonym", "expect": ["sqlite table:describe"] },
    { "q": "modify a comment", "group": "synonym", "expect": ["notion comment:update", "github issue-comment:update"] },
    { "q": "stopping a session", "group": "phrase", "expect": ["notion stop-session"] },
    { "q": "find messages from a person", "group": "synonym", "expect": ["gmail message:search", "slack channel-history:get"] },
    { "q": "list my emails", "group": "synonym", "expect": ["gmail message:search"] },
    { "q": "web page content extraction", "group": "synonym", "expect": ["tavily extract", "exa crawling"] },
    { "q": "look at the page structure", "group": "synonym", "expect": ["playwright browser-snapshot"] },
    { "q": "grab a snapshot of the screen", "group": "synonym", "expect": ["playwright browser-take-screenshot", "puppeteer screenshot", "playwright browser-snapshot"] },
    { "q": "ask a question about a library", "group": "synonym", "expect": ["context7 library-doc:get", "context7 library-id:resolve"] },
    { "q": "list all documents", "group": "synonym", "expect": ["linear document:list", "google-drive file:list"] },
    { "q": "update the issue status", "group": "synonym", "expect": ["linear issue:update", "github issue:write"] },
    { "q": "react to a message", "group": "synonym", "expect": ["slack reaction:add", "notion set-comment-reaction"] },
    { "q": "creating a new comment", "group": "phrase", "expect": ["linear comment:create", "notion comment:create"] }
  ]
}
