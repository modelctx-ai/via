{
  "tools": [
    {
      "name": "resolve-library-id",
      "description": "Resolve a package or product name to a Context7-compatible library ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "libraryName": {
            "type": "string"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
          "libraryName"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get-library-docs",
      "description": "Fetch up-to-date documentation for a library.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "context7CompatibleLibraryID": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "tokens": {
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "context7CompatibleLibraryID"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}
