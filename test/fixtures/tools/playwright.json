        "type": "object",
        "properties": {
          "element": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "element",
          "ref"
        ]
      }
    },
    {
      "name": "browser_select_option",
      "description": "Select an option in a dropdown.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "element": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "element",
          "ref",
          "values"
        ]
      }
    },
    {
