          "element": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "fullPage": {
            "type": "boolean"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "browser_snapshot",
