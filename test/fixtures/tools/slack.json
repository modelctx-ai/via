      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "string"
          },
          "thread_ts": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "channel_id",
          "thread_ts",
          "text"
        ]
      }
    },
    {
      "name": "slack_add_reaction",
