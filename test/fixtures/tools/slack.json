      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "reaction": {
            "type": "string"
          }
        },
        "required": [
          "channel_id",
          "timestamp",
          "reaction"
        ]
      }
    },
    {
      "name": "slack_get_channel_history",
      "description": "Get recent messages from a channel.",
